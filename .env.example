# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit it.

# Flask session secret (any long random string)
SECRET_KEY=change-me-to-a-random-string

# Stripe — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# SMTP / Email (Gmail) — for order receipts and order notifications
# SMTP_USER must be a Gmail address with 2FA + an App Password
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# Postgres connection (only set in production / Vercel; leave empty for local SQLite)
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
